
menuconfig SAI
    bool "Serial Audio Interface (SAI) bus drivers"
    select DMA
    help
      Enable support for the SAI (Serial Audio Interface) hardware bus.

if SAI

config SAI_INIT_PRIORITY
    int "Init priority"
    default KERNEL_INIT_PRIORITY_DEVICE
    help
      Device driver initialization priority.

comment "Device Drivers"

source "drivers/sai/Kconfig.*"

endif # SAI
